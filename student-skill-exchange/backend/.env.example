# ==============================================================================
# SkillSwap Backend Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL
# Copy this file to .env and adjust variables for your target deployment environment.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Client Application URL (Comma-separated for multiple allowed origins)
# Example: https://skillswap.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Option A: Host, User, Password)
DB_HOST=localhost
DB_USER=skillswap_user
DB_PASSWORD=your_strong_database_password_here
DB_NAME=student_skill_exchange
DB_PORT=3306
DB_SSL=false

# MySQL Database Configuration (Option B: Cloud Connection String for Railway/Aiven/AWS)
# If provided, DATABASE_URL takes precedence over individual host/user variables above.
# DATABASE_URL=mysql://user:password@host:3306/student_skill_exchange?ssl-mode=REQUIRED

# Authentication & JWT Configuration
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_64_character_hex_secret_key_in_production
JWT_EXPIRES_IN=7d
