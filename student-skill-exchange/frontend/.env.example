# ==============================================================================
# SkillSwap Frontend Environment Configuration Template (Vite)
# Vite bundles variables prefixed with VITE_ into the client static assets.
# DO NOT STORE SENSITIVE PRIVATE KEYS IN THIS FILE.
# ==============================================================================

# Backend REST API Base URL (Point to deployed backend or local server)
# Local: http://localhost:5000/api
# Production Example: https://api.skillswap.edu/api or https://skillswap-api.up.railway.app/api
VITE_API_BASE_URL=http://localhost:5000/api

# Real-Time Socket.IO Server URL (Point to deployed backend or local server)
# Local: http://localhost:5000
# Production Example: https://api.skillswap.edu or https://skillswap-api.up.railway.app
VITE_SOCKET_URL=http://localhost:5000
